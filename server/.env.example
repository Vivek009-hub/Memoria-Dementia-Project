NODE_ENV=development
PORT=5000
MONGO_URI=
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=
# Session lifetime in milliseconds (default: 604800000 = 7 days)
SESSION_TTL_MS=604800000
# Name of the HTTP-only session cookie
COOKIE_NAME=memora_session

# Admin Seed Credentials
ADMIN_EMAIL=admin@memora.com
ADMIN_PASSWORD=Admin@123456

# ── Daily Video Calling Infrastructure (Server-Side Only) ──
DAILY_API_KEY=
DAILY_DOMAIN=

# ── B9 Notification Providers (optional — leave blank to use mock providers) ──
PUSH_PROVIDER=
PUSH_PROVIDER_API_KEY=

EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
