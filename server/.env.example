NODE_ENV=development
PORT=5000
MONGO_URI=
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=
# Session lifetime in milliseconds (default: 604800000 = 7 days)
SESSION_TTL_MS=604800000
# Name of the HTTP-only session cookie
COOKIE_NAME=memora_session

# ── Daily Video Calling Infrastructure (Server-Side Only) ──
# Required for real Daily.co video room creation and meeting-token issuance.
# If left blank, Memora falls back to Mock Daily Provider for local development.
DAILY_API_KEY=
DAILY_DOMAIN=

# ── B9 Notification Providers (optional — leave blank to use mock providers) ──

# Push Notifications (e.g. FCM)
# Set PUSH_PROVIDER to the provider name (e.g. FCM) and provide the API key.
PUSH_PROVIDER=
PUSH_PROVIDER_API_KEY=

# Email Notifications (e.g. SENDGRID, SES)
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# SMS Notifications (e.g. TWILIO, AWS_SNS)
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
